---
/** The NARUZU mark (apps/web/public/icon.svg) inline, so it needs no request. Decorative unless `label` is set. */
interface Props {
  size?: number;
  label?: string;
  class?: string;
}
const { size = 32, label, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 256 256"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <rect width="256" height="256" rx="42" fill="#122b36"></rect>
  <path d="M62 188V68h20l92 85V68h21v120h-20L83 103v85z" fill="#f0f5f2"></path>
  <rect x="64" y="208" width="129" height="9" fill="#edac77"></rect>
</svg>
