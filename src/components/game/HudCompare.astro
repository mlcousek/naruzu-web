---
/**
 * Before/after comparison of two real screenshots (HUD Compact vs Large):
 * a range input moves the divide. Keyboard: arrow keys on the slider. Without
 * JavaScript both screenshots are shown, the second below the first.
 */
import Shot from "../Shot.astro";
import { SHOT_ALT } from "../../lib/shots";
---

<figure class="cmp" data-compare style="--split: 50%">
  <div class="cmp__frame">
    <div class="cmp__layer cmp__layer--a">
      <Shot
        name="hud-compact"
        alt={SHOT_ALT["hud-compact"]}
        sizes="(min-width: 64rem) 60vw, 94vw"
      />
      <span class="cmp__tag cmp__tag--a">Compact</span>
    </div>
    <div class="cmp__layer cmp__layer--b">
      <Shot
        name="hud-large"
        alt={SHOT_ALT["hud-large"]}
        sizes="(min-width: 64rem) 60vw, 94vw"
      />
      <span class="cmp__tag cmp__tag--b">Large</span>
    </div>
    <div class="cmp__handle" aria-hidden="true">
      <span></span>
    </div>
  </div>
  <div class="cmp__control" hidden data-control>
    <label for="cmp-split">
      Compare HUD sizes: Compact on the left, Large on the right
    </label>
    <input
      id="cmp-split"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-valuetext="Half and half"
    />
  </div>
  <figcaption class="cmp__caption">
    The same ride with the HUD size set to Compact and to Large. Normal sits in
    between.
  </figcaption>
</figure>

<style>
  .cmp {
    margin: 0;
  }
  .cmp__frame {
    position: relative;
    display: grid;
    gap: var(--nz-space-3);
  }
  .cmp__layer {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--nz-line);
    border-radius: var(--nz-radius-lg);
    background: #031d25;
  }
  .cmp__layer :global(img) {
    width: 100%;
    height: auto;
  }
  .cmp__tag {
    position: absolute;
    top: auto;
    bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--nz-radius-pill);
    background: #031d25d9;
    border: 1px solid #ffaa5c;
    color: #f4f7f4;
    font-size: var(--nz-fs-min);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cmp__tag--a {
    left: 0.75rem;
  }
  .cmp__tag--b {
    right: 0.75rem;
  }
  .cmp__handle {
    display: none;
  }
  /* With JS: stack the two layers and clip the top one at --split. */
  .cmp[data-ready] .cmp__frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--nz-line);
    border-radius: var(--nz-radius-lg);
    box-shadow: 0 30px 60px -30px #000c;
  }
  .cmp[data-ready] .cmp__layer {
    border: 0;
    border-radius: 0;
  }
  .cmp[data-ready] .cmp__layer--b {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--split));
  }
  .cmp[data-ready] .cmp__handle {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 3px;
    margin-left: -1.5px;
    background: #ffaa5c;
    pointer-events: none;
  }
  .cmp[data-ready] .cmp__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid #ffaa5c;
    border-radius: 50%;
    background: #031d25e6;
    transform: translate(-50%, -50%);
  }
  .cmp[data-ready] .cmp__handle span::before {
    content: "‹ ›";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #ffaa5c;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .cmp__control {
    margin-top: var(--nz-space-3);
  }
  .cmp__control label {
    display: block;
    margin-bottom: var(--nz-space-1);
    font-size: var(--nz-fs-sm);
    font-weight: 700;
  }
  .cmp__control input {
    width: 100%;
    min-height: var(--nz-target);
    margin: 0;
    accent-color: var(--nz-accent);
  }
  .cmp__caption {
    margin-top: var(--nz-space-2);
    font-size: var(--nz-fs-sm);
    color: var(--nz-muted);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-compare]")) {
    const control = root.querySelector<HTMLElement>("[data-control]")!;
    const input = control.querySelector("input")!;
    const frame = root.querySelector<HTMLElement>(".cmp__frame")!;
    const set = (value: number) => {
      const v = Math.min(100, Math.max(0, value));
      input.value = String(v);
      root.style.setProperty("--split", `${v}%`);
      input.setAttribute(
        "aria-valuetext",
        v < 5
          ? "All Large"
          : v > 95
            ? "All Compact"
            : `${Math.round(v)} percent Compact`,
      );
    };
    input.addEventListener("input", () => set(Number(input.value)));
    // Drag on the picture too (pointer users); the slider stays the accessible control.
    let dragging = false;
    const fromPointer = (event: PointerEvent) => {
      const rect = frame.getBoundingClientRect();
      set(((event.clientX - rect.left) / rect.width) * 100);
    };
    frame.addEventListener("pointerdown", (event) => {
      dragging = true;
      frame.setPointerCapture(event.pointerId);
      fromPointer(event);
    });
    frame.addEventListener(
      "pointermove",
      (event) => dragging && fromPointer(event),
    );
    frame.addEventListener("pointerup", () => (dragging = false));
    frame.addEventListener("pointercancel", () => (dragging = false));
    frame.style.touchAction = "pan-y";
    control.hidden = false;
    root.setAttribute("data-ready", "");
    set(50);
  }
</script>
