---
/**
 * Sets the theme before first paint (no flash). Dark is the default; a choice
 * made with ThemeToggle is stored under the same key Starlight uses, so the
 * marketing pages and the docs always agree.
 */
---

<script is:inline>
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("starlight-theme");
    } catch {}
    document.documentElement.dataset.theme =
      stored === "light" ? "light" : "dark";
    document.documentElement.classList.add("js");
  })();
</script>
