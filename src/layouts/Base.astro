---
/**
 * The marketing layout (Home, About, The game, 404): head and SEO, skip link,
 * Nav, <main id="main">, Footer and the reveal-on-scroll observer.
 *
 *   ---
 *   import Base from "../layouts/Base.astro";
 *   ---
 *   <Base title="About" description="...">...</Base>
 */
import "../styles/base.css";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import ThemeInit from "../components/ThemeInit.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";

type Props = SeoProps;
const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#031d25" />
    <meta name="generator" content={Astro.generator} />
    <ThemeInit />
    <Seo {...props} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <slot name="head" />
  </head>
  <body>
    <a class="nz-skip-link" href="#main">
      Skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { observeReveal } from "../lib/motion";
      observeReveal();
    </script>
  </body>
</html>
